# 忽略本地環境變數檔案
# 這非常重要，絕對不要上傳含有金鑰的檔案！
.env
.env.local
.env.*.local
.env.*

# KTV 主機 Google 部署設定與加密帳號狀態不得進入版本庫。
google_drive_deploy.json
google_drive_account.bin
drive_downloads/
song_data_sync.json
song_notes.json
song_play_counts.json

# 忽略 Node.js 依賴套件資料夾
node_modules/

# 忽略日誌檔案
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*


# 忽略本地輸出
.venv/
build/
dist/

# 忽略作業系統產生的檔案
.DS_Store
Thumbs.db
.venv

# 忽略 Python 快取與本機產生資料
__pycache__/
*.py[cod]
pretrained_models/
temp_processing/
ktv_songs/

# Windows Server instance lock is generated at runtime and should not be committed.
/.ianAutoKTV.instance.lock
